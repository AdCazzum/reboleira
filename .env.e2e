# Env for the automated end-to-end run (`npm run e2e`, mode=e2e).
#
# Deliberately points every live dependency at a closed port so the extension's
# live paths fail IMMEDIATELY (connection refused) and fall back to the bundled
# personas + pre-computed fixtures. That is what makes the e2e deterministic:
# no network, no wallet, no testnet funds, no human approving a signature.
#
# It also means the run exercises the fallback machinery for real — the safety
# net the demo depends on when a testnet is flaky.
#
# Committed on purpose: it holds no secrets. The real values live in .env
# (gitignored); see .env.example.

VITE_SEPOLIA_RPC=http://127.0.0.1:1
VITE_ZEROG_RPC=http://127.0.0.1:1
VITE_ZEROG_INDEXER=http://127.0.0.1:1

# Empty on purpose: the content script then skips the live-inference attempt
# outright and renders the fixture (see src/config.ts).
VITE_ZEROG_INFERENCE_PROVIDER=

VITE_ENS_NAME=ensight-e2e.eth

# Closed port: exercises the popup's "onboarding server not reachable" branch.
VITE_ONBOARDING_URL=http://127.0.0.1:1/onboarding.html

VITE_WORLD_APP_ID=app_e2e_placeholder
VITE_WORLD_ACTION=verify-human
